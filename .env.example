# ── Image ──
# Which published image to run; defaults to latest. Set this to pin a release:
#   ghcr.io/piconbello/humanode-docker  tags: latest, <upstream>, <upstream>-r<n>
#HMND_IMAGE_TAG=v0.0.15-r7

# ── Node ──
#SYNC_MODE=
#NODE_NAME=
#DB_CACHE=256
#STATE_PRUNING=
#BLOCKS_PRUNING=

# ── Validator ──
# Set VALIDATOR=true to enable validator mode and bioauth tunnel.
#VALIDATOR=true

# By default the built-in Humanode tunnel is used (no account needed).
# Set NGROK_AUTHTOKEN to use ngrok instead.
#NGROK_AUTHTOKEN=

# ── Catch-up ──
#CATCHUP_MAX_BLOCK_AGE=2m
#CATCHUP_MAX_BLOCK_GAP=20
#CATCHUP_CHECKPOINTS=1d,6h,1h,15m
#CATCHUP_NO_PROGRESS_AFTER=30m
#CATCHUP_NO_PROGRESS_REMIND_AFTER=30m,1h,2h

# ── Tunnel health (native tunnel only) ──
#TUNNEL_HEALTH_POLL=30s
#TUNNEL_RESTART_BACKOFF=30s,1m,5m,15m,30m
#TUNNEL_MAX_IDLE_TIMEOUT=60s

# ── Telegram bot ──
# All three are required for the bot to start.
#ENABLE_BOT=true
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_USER_ID=

# ── Facescan reminders ──
# BIOAUTH_REMIND_BEFORE is absolute: each value is a time before expiry.
# BIOAUTH_REMIND_AFTER is CUMULATIVE: each value is measured from the previous
# reminder, so 15m,45m,2h fires at 15m, 1h and 3h after expiry.
#
# Defaults fire at 1s before expiry, then
#   15m, 1h, 3h, 6h, 12h, 1d, 3d, 7d  after it, repeating every 4d.
# Set either to 'off' to disable that half; an empty value falls back to the
# default, it does not disable. Units: s, m, h, d.
#BIOAUTH_REMIND_BEFORE=1s
#BIOAUTH_REMIND_AFTER=15m,45m,2h,3h,6h,12h,2d,4d

# ── Stall alerts ──
# On by default, and only active once the first sync completes.
# BLOCK_STALL_THRESHOLD: best block has not advanced for this long.
#   30s = 5 blocks at the 6s nominal block time.
# FINALITY_MAX_LAG: how many blocks finality may trail the best block by.
#   Measured on mainnet, finality runs 2-3 behind, so 4+ means GRANDPA is not
#   keeping up. Set to "off" to disable; deleting the line restores the default.
# Both alert the moment they are detected, then repeat on the cadence below
# (cumulative; the last interval repeats) until the condition clears.
#BLOCK_STALL_THRESHOLD=30s
#BLOCK_STALL_REMIND_AFTER=1h
#FINALITY_MAX_LAG=3
#FINALITY_LAG_REMIND_AFTER=1h
