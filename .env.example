# ── Node ──
#SYNC_MODE=
#NODE_NAME=
#DB_CACHE=256
#STATE_PRUNING=
#BLOCKS_PRUNING=

# ── Validator ──
# Set VALIDATOR=true to enable validator mode and bioauth tunnel.
#VALIDATOR=true

# By default the built-in Humanode tunnel is used (no account needed).
# Set NGROK_AUTHTOKEN to use ngrok instead.
#NGROK_AUTHTOKEN=

# ── Catch-up ──
#CATCHUP_MAX_BLOCK_AGE=2m
#CATCHUP_MAX_BLOCK_GAP=20
#CATCHUP_CHECKPOINTS=1d,6h,1h,15m
#CATCHUP_NO_PROGRESS_AFTER=30m
#CATCHUP_NO_PROGRESS_REMIND_AFTER=30m,1h,2h

# ── Tunnel health (native tunnel only) ──
#TUNNEL_HEALTH_POLL=30s
#TUNNEL_RESTART_BACKOFF=30s,1m,5m,15m,30m
#TUNNEL_MAX_IDLE_TIMEOUT=60s

# ── Telegram bot ──
# All three are required for the bot to start.
#ENABLE_BOT=true
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_USER_ID=

# ── Facescan reminders ──
# BIOAUTH_REMIND_BEFORE is absolute: each value is a time before expiry.
# BIOAUTH_REMIND_AFTER is CUMULATIVE: each value is measured from the previous
# reminder, so 15m,45m,2h fires at 15m, 1h and 3h after expiry.
#
# Defaults fire at 1s before expiry, then
#   15m, 1h, 3h, 6h, 12h, 1d, 3d, 7d  after it, repeating every 4d.
# Set either to 'off' to disable that half; an empty value falls back to the
# default, it does not disable. Units: s, m, h, d.
#BIOAUTH_REMIND_BEFORE=1s
#BIOAUTH_REMIND_AFTER=15m,45m,2h,3h,6h,12h,2d,4d

# ── Stall alerts ──
# Opt-in: each pair must both be set to take effect.
#BLOCK_STALL_THRESHOLD=10m
#BLOCK_STALL_REMIND_AFTER=30m,1h,2h
#FINALITY_STALL_THRESHOLD=30m
#FINALITY_STALL_REMIND_AFTER=1h,2h
