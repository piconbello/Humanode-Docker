# ── Image ──
# Which published image to run; defaults to latest. Set this to pin a release:
#   ghcr.io/piconbello/humanode-docker  tags: latest, <upstream>, <upstream>-r<n>
#HMND_IMAGE_TAG=v0.0.15-r7

# ── Node ──
#SYNC_MODE=
#NODE_NAME=
#DB_CACHE=256
#STATE_PRUNING=
#BLOCKS_PRUNING=
# Extra humanode-peer flags, appended as-is. Do not repeat flags the image already
# sets (--rpc-port, --rpc-cors, --port, --sync, --name, --base-path, --chain).
#NODE_EXTRA_ARGS=

# ── RPC proxy ──
# Serves an allowlist of read-only eth_/chain_/state_/system_ methods plus
# eth_sendRawTransaction. Key, bioauth and node-admin methods are refused.
# The node RPC itself stays on 127.0.0.1:9944. Restrict who can reach the
# proxy with the compose port binding (e.g. "100.x.y.z:9945:9945").
#RPC_PROXY=true
#RPC_PROXY_PORT=9945

# ── Tunnel filter ──
# With VALIDATOR=true the bioauth tunnel reaches the node through a filter that
# refuses key-insert, peer/log admin, offchain and heavy state methods. Session
# key setup (author_rotateKeys, authorExt_setKeys) stays open until the
# validator's session keys are on chain; set TUNNEL_KEY_SETUP=true to reopen it,
# e.g. after moving the node. TUNNEL_FILTER=false sends the tunnel straight to
# the node, exposing every RPC method to anyone with the tunnel URL.
#TUNNEL_FILTER=true
#TUNNEL_KEY_SETUP=false

# ── Validator ──
# Set VALIDATOR=true to enable validator mode and bioauth tunnel.
#VALIDATOR=true

# By default the built-in Humanode tunnel is used (no account needed).
# Set NGROK_AUTHTOKEN to use ngrok instead.
#NGROK_AUTHTOKEN=

# ── Catch-up ──
#CATCHUP_MAX_BLOCK_AGE=2m
#CATCHUP_MAX_BLOCK_GAP=20
#CATCHUP_CHECKPOINTS=1d,6h,1h,15m
#CATCHUP_NO_PROGRESS_AFTER=30m
#CATCHUP_NO_PROGRESS_REMIND_AFTER=30m,1h,2h

# ── Tunnel health (native tunnel only) ──
#TUNNEL_HEALTH_POLL=30s
#TUNNEL_RESTART_BACKOFF=30s,1m,5m,15m,30m
#TUNNEL_MAX_IDLE_TIMEOUT=60s

# ── Telegram bot ──
# All three are required for the bot to start.
#ENABLE_BOT=true
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_USER_ID=

# ── Facescan reminders ──
# BIOAUTH_REMIND_BEFORE is absolute: each value is a time before expiry.
# BIOAUTH_REMIND_AFTER is CUMULATIVE: each value is measured from the previous
# reminder, so 15m,45m,2h fires at 15m, 1h and 3h after expiry.
#
# Defaults fire at 1s before expiry, then
#   15m, 1h, 3h, 6h, 12h, 1d, 3d, 7d  after it, repeating every 4d.
# Set either to 'off' to disable that half; an empty value falls back to the
# default, it does not disable. Units: s, m, h, d.
#BIOAUTH_REMIND_BEFORE=1s
#BIOAUTH_REMIND_AFTER=15m,45m,2h,3h,6h,12h,2d,4d

# ── Stall alerts ──
# On by default, and only active once the first sync completes.
# BLOCK_STALL_THRESHOLD: best block has not advanced for this long.
#   30s = 5 blocks at the 6s nominal block time.
# FINALITY_MAX_LAG: how many blocks finality may trail the best block by.
#   Measured on mainnet, finality runs 2-3 behind, so 4+ means GRANDPA is not
#   keeping up. Set to "off" to disable; deleting the line restores the default.
# Block stall alerts as soon as it is detected; finality lag alerts after two
# polls in a row (~30s). Both repeat on the cadence below (cumulative; the last
# interval repeats) until the condition clears.
#BLOCK_STALL_THRESHOLD=30s
#BLOCK_STALL_REMIND_AFTER=1h
#FINALITY_MAX_LAG=3
#FINALITY_LAG_REMIND_AFTER=1h

# ── Governance alerts ──
# Monitor the Vortex governance API for proposal activity.
# Each tier is independent and off by default. Set true to enable, false to disable.
# GOV_NEW_PROPOSALS: a proposal is submitted.
# GOV_STAGE_CHANGES: a proposal advances from the pool, fails, its window ends,
#   it returns to draft, a vote passes into the veto window, or a vote is finalized.
# GOV_MILESTONES: a formation milestone is submitted.
#GOV_NEW_PROPOSALS=true
#GOV_STAGE_CHANGES=true
#GOV_MILESTONES=true
#GOV_POLL_INTERVAL=15m
#GOV_API_BASE=https://vortex-simulator.humanode.io

# ── Image update notices ──
# How often the bot checks GitHub for a newer published image and DMs you once
# per new release. Set to 'off' to disable. Units: s, m, h, d.
#UPDATE_CHECK_INTERVAL=6h
