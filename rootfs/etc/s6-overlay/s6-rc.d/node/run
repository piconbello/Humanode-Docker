#!/command/with-contenv sh
set -eu

NODE_NAME="${NODE_NAME:-humanode-validator}"
SYNC_MODE="${SYNC_MODE:-full}"
VALIDATOR="${VALIDATOR:-false}"
DB_CACHE="${DB_CACHE:-256}"

VALIDATOR_ARGS=""
if [ "$VALIDATOR" = "true" ]; then
    VALIDATOR_ARGS="--validator --rpc-url-ngrok-detect"
fi

PRUNING_ARGS=""
if [ -n "${STATE_PRUNING:-}" ]; then
    PRUNING_ARGS="--state-pruning ${STATE_PRUNING}"
fi
if [ -n "${BLOCKS_PRUNING:-}" ]; then
    PRUNING_ARGS="${PRUNING_ARGS} --blocks-pruning ${BLOCKS_PRUNING}"
fi

exec 2>&1
exec s6-setuidgid hmnd \
    humanode-peer \
        $VALIDATOR_ARGS \
        --chain /etc/humanode/chainspec.json \
        --base-path /data \
        --name "${NODE_NAME}" \
        --rpc-port 9944 \
        --rpc-cors all \
        --sync "${SYNC_MODE}" \
        --port 30333 \
        --db-cache "${DB_CACHE}" \
        ${PRUNING_ARGS}
