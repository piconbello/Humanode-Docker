#!/command/execlineb -P

with-contenv
importas -D "humanode-validator" NODE_NAME NODE_NAME
importas -D "full" SYNC_MODE SYNC_MODE

fdmove -c 2 1
s6-setuidgid hmnd
humanode-peer
    --validator
    --chain /etc/humanode/chainspec.json
    --base-path /data
    --name ${NODE_NAME}
    --rpc-port 9944
    --rpc-cors none
    --sync ${SYNC_MODE}
    --port 30333
